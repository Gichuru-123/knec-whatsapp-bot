{
  "name": "knec-whatsapp-bot",
  "version": "0.1.0",
  "description": "KNEC Digital Assistant - Automated WhatsApp Customer Care & KB Engine",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --require ./tests/helpers/testEnv.js --test tests/*.test.js tests/**/*.test.js",
    "validate-kb": "node scripts/validate-kb.js",
    "lint": "eslint . --max-warnings=0",
    "scan:secrets": "node scripts/scan-secrets.js",
    "check": "npm run lint && npm run scan:secrets && npm run validate-kb && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "twilio": "6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "secretlint": "13.0.7",
    "supertest": "^7.0.0"
  }
}
