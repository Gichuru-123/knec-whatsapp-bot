{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "service_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "language": {
      "enum": [
        "en",
        "sw"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "retired"
      ]
    },
    "verification_status": {
      "enum": [
        "unverified",
        "source_checked",
        "verified"
      ]
    },
    "visibility": {
      "enum": [
        "public",
        "internal"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "examinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "years": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "programmes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          }
        }
      },
      "required": [
        "examinations",
        "audiences",
        "years"
      ]
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "clarifying_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "orientation",
              "requirement",
              "step",
              "fee",
              "timeline",
              "exception",
              "contact"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "evidence_status": {
            "enum": [
              "supported",
              "unresolved"
            ]
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "source_id",
                "locator",
                "source_sha256"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "evidence_status",
          "citations"
        ]
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "effective_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "calendar-date"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "calendar-date"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_due": {
      "type": "string",
      "format": "calendar-date"
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "role": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "approved_on": {
              "type": "string",
              "format": "calendar-date"
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "reviewer",
            "role",
            "approved_on",
            "content_sha256"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "service_id",
    "category",
    "title",
    "description",
    "language",
    "version",
    "status",
    "verification_status",
    "visibility",
    "scope",
    "intents",
    "clarifying_questions",
    "claims",
    "unresolved_questions",
    "effective_from",
    "effective_to",
    "review_due",
    "approval"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
