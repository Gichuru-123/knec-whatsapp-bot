{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "publisher": {
        "const": "KNEC"
      },
      "url": {
        "type": "string",
        "format": "official-url"
      },
      "document_date": {
        "anyOf": [
          {
            "type": "string",
            "format": "calendar-date"
          },
          {
            "type": "null"
          }
        ]
      },
      "retrieved_on": {
        "type": "string",
        "format": "calendar-date"
      },
      "review_due": {
        "type": "string",
        "format": "calendar-date"
      },
      "review_status": {
        "enum": [
          "discovered",
          "inspected",
          "superseded"
        ]
      },
      "sha256": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "local_filename": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          {
            "type": "null"
          }
        ]
      },
      "notes": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "required": [
      "id",
      "title",
      "publisher",
      "url",
      "document_date",
      "retrieved_on",
      "review_due",
      "review_status",
      "sha256",
      "local_filename",
      "notes"
    ]
  }
}
