# Copy this file to .env and fill in your own values.
# This file must only ever contain placeholders: never put real credentials here.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
# Disabled by default. Opt in only for local development; production rejects true.
# Never enable while a tunnel is open. Development also rejects true with TRUST_PROXY_HOPS > 0.
ENABLE_DEV_INSPECTION_ROUTES=false

# Phase 4 WhatsApp Configuration
# Explicit selection is required; there is no provider fallback. Twilio is not implemented yet.
# "mock" = local development without Meta credentials (allowed only when NODE_ENV is development or test).
# "meta" = Meta WhatsApp Cloud API.
WHATSAPP_PROVIDER=mock

# Required in every environment. Choose your own long random string; Meta does not issue this value.
WHATSAPP_VERIFY_TOKEN=

# Required when WHATSAPP_PROVIDER=meta. There is no built-in default: set it explicitly (format vNN.N)
# after checking Meta's supported versions: https://developers.facebook.com/docs/graph-api/changelog/versions/
META_GRAPH_API_VERSION=

# Required when WHATSAPP_PROVIDER=meta (access token and phone number ID are also required in production).
# WHATSAPP_APP_SECRET and WHATSAPP_ACCESS_TOKEN are secrets: never commit or share them.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_REQUEST_TIMEOUT_MS=10000
# Numeric settings accept whole decimal numbers only (no spaces, fractions or trailing text).
# Timeout covers response headers AND response-body consumption.

# Webhook Request Protection (the body limit applies to the webhook only; other routes allow 10kb)
WEBHOOK_BODY_LIMIT=100kb
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=100

# Number of tunnels/proxies in front of the app. Keep 0 when running directly on your computer.
# Set to 1 only while exactly one tunnel (or one cloud load balancer) forwards requests to the app.
# A value higher than reality lets clients fake their address and get around the rate limit.
TRUST_PROXY_HOPS=0
